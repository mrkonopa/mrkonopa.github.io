# Vynutit LF pro textové soubory — zabraňuje CRLF churn na Windows (Git Bash).
# Bez tohoto se unikovka_procenta.html (a další) jevily jako trvale modified.
* text=auto eol=lf

*.html  text eol=lf
*.js    text eol=lf
*.css   text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.svg   text eol=lf
*.sql   text eol=lf
*.cjs   text eol=lf
*.sh    text eol=lf

# Binární — nikdy nediffovat / nekonvertovat konce řádků.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.pdf   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.ico   binary

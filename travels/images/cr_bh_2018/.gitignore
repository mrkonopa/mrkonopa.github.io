# Full-resolution / large source files stay on disk but aren't tracked.
# Only the web-sized .jpg variants get committed.
*.png
*.PNG
*.tif
*.tiff
*.TIF
*.TIFF
*.NEF
*.RAW
*.CR2
*.CR3
*.HEIC
*.heic

# Block original JPGs — only allow *_web.jpg and *_LQ.jpg
*.jpg
*.JPG
!*_web.jpg
!*_LQ.jpg

# Video files — host externally (YouTube/Vimeo).
*.mp4
*.mov
*.MOV
*.MP4
